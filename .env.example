# ============================================================================
# SLPZY · Environment
# Copy to .env.local and fill in real values.
# ============================================================================

# --- Database (Supabase Postgres) ---
# Supabase Dashboard → Settings → Database → Connection string → Transaction pooler
# Format: postgresql://postgres.<REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# --- Supabase Storage (image uploads) ---
SUPABASE_URL="https://YOUR_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="slpzy-media"

# --- CMS access ---
# The single shared access code for /cms-panel
CMS_ACCESS_CODE="sepretencel"

# --- Email (Resend) ---
# Resend Dashboard → API Keys. The slpzy.co domain must be verified in Resend.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Senders — must be addresses on the verified slpzy.co domain
EMAIL_FROM_NEWSLETTER="SLPZY <goodmorning@slpzy.co>"
EMAIL_FROM_ORDERS="SLPZY <goodnight@slpzy.co>"
# Admin recipient for new-order notifications
ADMIN_EMAIL="sleepeazy.id@gmail.com"

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
